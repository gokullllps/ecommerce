# ==============================================================================
# PABLO LUXURY ATELIER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# PABLO uses JSON as the canonical data source — no database is required.
# NEVER commit real credentials or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: development | test | production
APP_ENV=development
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. PABLO ADMIN AUTHENTICATION (SERVER-SIDE CREDENTIALS)
# ------------------------------------------------------------------------------
# Configure admin credentials via environment variables.
# Passwords must be bcrypt hashes ($2b$... or $2a$...).
# NEVER commit actual emails or password hashes to source control.
PABLO_ADMIN_1_EMAIL=
PABLO_ADMIN_1_PASSWORD_HASH=

PABLO_ADMIN_2_EMAIL=
PABLO_ADMIN_2_PASSWORD_HASH=

PABLO_ADMIN_3_EMAIL=
PABLO_ADMIN_3_PASSWORD_HASH=

# Cryptographically random secret used to sign secure HTTP-only admin session cookies
# Must be at least 32 characters in production.
PABLO_SESSION_SECRET=

# ------------------------------------------------------------------------------
# 3. MEDIA ASSET STORAGE
# ------------------------------------------------------------------------------
# Options:
# - local : Static file serving from public/uploads (Development default)
# - s3    : AWS S3 Object Storage (Production)
# - r2    : Cloudflare R2 Object Storage (Production alternative)
MEDIA_PROVIDER=local

# ------------------------------------------------------------------------------
# 4. OBSERVABILITY & RATE LIMITING
# ------------------------------------------------------------------------------
LOG_LEVEL=info
ADMIN_RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=5
CHECKOUT_RATE_LIMIT_PER_MINUTE=10
